    "SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20",
    "SERVER_TOMCAT_MAX_CONNECTIONS=256",
    "SERVER_TOMCAT_ACCEPT_COUNT=256"
  ]
}