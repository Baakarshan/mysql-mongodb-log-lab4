{
  "Cmd": [
    "java",
    "-Xms64m",
    "-Xmx128m",
    "-Xss256k",
    "-XX:MaxMetaspaceSize=128m",
    "-jar",
    "/app.jar"
  ],
  "Env": [
    "SPRING_PROFILES_ACTIVE=mongo",
